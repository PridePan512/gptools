<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llCardContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp">

    <TextView
        android:id="@+id/tvCardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <TextView
        android:id="@+id/tvCardCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?attr/textAppearanceBody2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCardPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCardChangePercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCardChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="?attr/textAppearanceBody2" />
    </LinearLayout>

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:stretchColumns="1,3">

        <TableRow>

            <TextView
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/metric_open"
                android:textAppearance="?attr/textAppearanceCaption" />

            <TextView
                android:id="@+id/tvOpen"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:textAppearance="?attr/textAppearanceBody2" />

            <TextView
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/metric_prev_close"
                android:textAppearance="?attr/textAppearanceCaption" />

            <TextView
                android:id="@+id/tvPrevClose"
                android:paddingTop="4dp"
                android:textAppearance="?attr/textAppearanceBody2" />
        </TableRow>

        <TableRow>

            <TextView
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/metric_high"
                android:textAppearance="?attr/textAppearanceCaption" />

            <TextView
                android:id="@+id/tvHigh"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:textAppearance="?attr/textAppearanceBody2" />

            <TextView
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/metric_low"
                android:textAppearance="?attr/textAppearanceCaption" />

            <TextView
                android:id="@+id/tvLow"
                android:paddingTop="4dp"
                android:textAppearance="?attr/textAppearanceBody2" />
        </TableRow>

        <TableRow>

            <TextView
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/metric_volume"
                android:textAppearance="?attr/textAppearanceCaption" />

            <TextView
                android:id="@+id/tvVolume"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:textAppearance="?attr/textAppearanceBody2" />

            <TextView
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/metric_amount"
                android:textAppearance="?attr/textAppearanceCaption" />

            <TextView
                android:id="@+id/tvAmount"
                android:paddingTop="4dp"
                android:textAppearance="?attr/textAppearanceBody2" />
        </TableRow>

        <TableRow>

            <TextView
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/metric_turnover"
                android:textAppearance="?attr/textAppearanceCaption" />

            <TextView
                android:id="@+id/tvTurnover"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:textAppearance="?attr/textAppearanceBody2" />

            <TextView
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/metric_amplitude"
                android:textAppearance="?attr/textAppearanceCaption" />

            <TextView
                android:id="@+id/tvAmplitude"
                android:paddingTop="4dp"
                android:textAppearance="?attr/textAppearanceBody2" />
        </TableRow>

        <TableRow>

            <TextView
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/metric_pe"
                android:textAppearance="?attr/textAppearanceCaption" />

            <TextView
                android:id="@+id/tvPe"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:textAppearance="?attr/textAppearanceBody2" />

            <TextView
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/metric_pb"
                android:textAppearance="?attr/textAppearanceCaption" />

            <TextView
                android:id="@+id/tvPb"
                android:paddingTop="4dp"
                android:textAppearance="?attr/textAppearanceBody2" />
        </TableRow>
    </TableLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBids"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceBody2" />

        <TextView
            android:id="@+id/tvAsks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceBody2" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvToggleRaw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/show_raw_fields"
        android:textColor="?attr/colorPrimary" />

    <TextView
        android:id="@+id/tvRawDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textIsSelectable="true"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>

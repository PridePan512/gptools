<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_quote_detail"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvCardPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/quote_detail_placeholder"
        android:textAppearance="?attr/textAppearanceBody2" />

    <LinearLayout
        android:id="@+id/llCardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadline6" />

        <TextView
            android:id="@+id/tvCardCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBody2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCardPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCardChangePercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCardChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="?attr/textAppearanceBody2" />
        </LinearLayout>

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:stretchColumns="1,3">

            <TableRow>
                <TextView android:text="@string/metric_open" android:textAppearance="?attr/textAppearanceCaption" android:paddingTop="4dp" android:paddingEnd="8dp" />
                <TextView android:id="@+id/tvOpen" android:textAppearance="?attr/textAppearanceBody2" android:paddingTop="4dp" android:paddingEnd="12dp" />
                <TextView android:text="@string/metric_prev_close" android:textAppearance="?attr/textAppearanceCaption" android:paddingTop="4dp" android:paddingEnd="8dp" />
                <TextView android:id="@+id/tvPrevClose" android:textAppearance="?attr/textAppearanceBody2" android:paddingTop="4dp" />
            </TableRow>

            <TableRow>
                <TextView android:text="@string/metric_high" android:textAppearance="?attr/textAppearanceCaption" android:paddingTop="4dp" android:paddingEnd="8dp" />
                <TextView android:id="@+id/tvHigh" android:textAppearance="?attr/textAppearanceBody2" android:paddingTop="4dp" android:paddingEnd="12dp" />
                <TextView android:text="@string/metric_low" android:textAppearance="?attr/textAppearanceCaption" android:paddingTop="4dp" android:paddingEnd="8dp" />
                <TextView android:id="@+id/tvLow" android:textAppearance="?attr/textAppearanceBody2" android:paddingTop="4dp" />
            </TableRow>

            <TableRow>
                <TextView android:text="@string/metric_volume" android:textAppearance="?attr/textAppearanceCaption" android:paddingTop="4dp" android:paddingEnd="8dp" />
                <TextView android:id="@+id/tvVolume" android:textAppearance="?attr/textAppearanceBody2" android:paddingTop="4dp" android:paddingEnd="12dp" />
                <TextView android:text="@string/metric_amount" android:textAppearance="?attr/textAppearanceCaption" android:paddingTop="4dp" android:paddingEnd="8dp" />
                <TextView android:id="@+id/tvAmount" android:textAppearance="?attr/textAppearanceBody2" android:paddingTop="4dp" />
            </TableRow>

            <TableRow>
                <TextView android:text="@string/metric_turnover" android:textAppearance="?attr/textAppearanceCaption" android:paddingTop="4dp" android:paddingEnd="8dp" />
                <TextView android:id="@+id/tvTurnover" android:textAppearance="?attr/textAppearanceBody2" android:paddingTop="4dp" android:paddingEnd="12dp" />
                <TextView android:text="@string/metric_amplitude" android:textAppearance="?attr/textAppearanceCaption" android:paddingTop="4dp" android:paddingEnd="8dp" />
                <TextView android:id="@+id/tvAmplitude" android:textAppearance="?attr/textAppearanceBody2" android:paddingTop="4dp" />
            </TableRow>

            <TableRow>
                <TextView android:text="@string/metric_pe" android:textAppearance="?attr/textAppearanceCaption" android:paddingTop="4dp" android:paddingEnd="8dp" />
                <TextView android:id="@+id/tvPe" android:textAppearance="?attr/textAppearanceBody2" android:paddingTop="4dp" android:paddingEnd="12dp" />
                <TextView android:text="@string/metric_pb" android:textAppearance="?attr/textAppearanceCaption" android:paddingTop="4dp" android:paddingEnd="8dp" />
                <TextView android:id="@+id/tvPb" android:textAppearance="?attr/textAppearanceBody2" android:paddingTop="4dp" />
            </TableRow>
        </TableLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBids"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textAppearance="?attr/textAppearanceBody2" />

            <TextView
                android:id="@+id/tvAsks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textAppearance="?attr/textAppearanceBody2" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvToggleRaw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/show_raw_fields"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tvRawDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
